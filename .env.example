# Copy to .env and fill in. Never commit .env.

# MongoDB Atlas connection string (db_mode=auto falls back to in-memory if unreachable)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=itsm
MONGODB_DB=itsm_helpdesk
DB_MODE=auto

# LLM: local | hf_inference | extractive
LLM_PROVIDER=local
LLM_LOCAL_MODEL=Qwen/Qwen2.5-0.5B-Instruct
LLM_HF_MODEL=Qwen/Qwen2.5-7B-Instruct
# HF_TOKEN=hf_xxx            # required for LLM_PROVIDER=hf_inference
LLM_DEVICE=cpu

EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_MIN_SCORE=0.45
CONFIDENCE_THRESHOLD=0.60

# ServiceNow: mock | live
SERVICENOW_MODE=mock
# SERVICENOW_INSTANCE=https://devXXXXX.service-now.com
# SERVICENOW_USER=admin
# SERVICENOW_PASSWORD=

PROVISIONING_STEP_SECONDS=6
